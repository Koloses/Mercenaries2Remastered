#include <winuser.h>
1 RT_MANIFEST "setup.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Mercenaries2Remastered Setup"
      VALUE "ProductName", "Mercenaries2Remastered"
      VALUE "FileVersion", "Beta 2"
      VALUE "ProductVersion", "Beta 2"
      VALUE "LegalCopyright", "Copyright (C) 2026 the Mercenaries2Remastered authors, GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
